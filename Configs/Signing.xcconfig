// Signing defaults that work on any Mac without an Apple Developer account:
// an ad-hoc ("Sign to Run Locally") signature and no team. Release builds for
// distribution get their identity from the release workflow instead.
//
// To sign with your own team, copy Local.xcconfig.example to Local.xcconfig
// (it is gitignored) and fill it in.

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

// Debug appends .debug and the hook helper appends .hook. Change this in
// Local.xcconfig if you sign with your own team, because an App ID can only
// belong to one team.
ARCHIPEL_BUNDLE_ID = de.jandow.Archipel

#include? "Local.xcconfig"
