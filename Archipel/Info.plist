<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deployed to GitHub Pages by .github/workflows/pages.yml. -->
	<key>SUFeedURL</key>
	<string>https://robertjndw.github.io/archipel/appcast.xml</string>
	<!-- Public half of the EdDSA key from Sparkle's generate_keys. The release workflow refuses to
	     publish while this is still the placeholder, since every update would fail verification. -->
	<key>SUPublicEDKey</key>
	<string>M+kcDmMiIktS7NiEG47oMngB50kLDYfxa87DQDu7yB4=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- A tab being dragged between panes. See TabDragItem. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>de.jandow.archipel.tab</string>
			<key>UTTypeDescription</key>
			<string>Archipel Tab</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
