{
  "jsonrpc": "2.0",
  "id": 1,
  "result": {
    "protocolVersion": 1,
    "agentCapabilities": {
      "loadSession": true,
      "mcpCapabilities": {
        "http": true,
        "sse": false
      },
      "promptCapabilities": {
        "embeddedContext": true,
        "image": true
      },
      "sessionCapabilities": {
        "additionalDirectories": {},
        "close": {},
        "delete": {},
        "fork": {},
        "list": {},
        "resume": {}
      },
      "_meta": {
        "opencode/child-session-updates": true
      }
    },
    "authMethods": [
      {
        "description": "Run `opencode auth login` in the terminal",
        "name": "Login with opencode",
        "id": "opencode-login",
        "type": "terminal",
        "args": [
          "--login"
        ]
      }
    ],
    "_meta": {
      "steering": {
        "supported": true
      }
    },
    "agentInfo": {
      "name": "OpenCode",
      "version": "2.4.1"
    }
  }
}
